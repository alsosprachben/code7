# syntax=docker/dockerfile:experimental

ARG font="code7"
FROM fontforge as ttf
ARG font="code7"
ENV font=${font}
COPY / /code7
WORKDIR /code7
RUN mkdir -p ttf
RUN awk '/^POINT_SIZE / { print "POINT_SIZE " int(($2 + 5) / 10); next } { print }' ${font}.bdf > /tmp/${font}.bdf
RUN bdf2ttf /tmp/${font}.bdf --out ttf/${font}.ttf
