*VT100.colorBD: gray70
*VT100.colorBDMode: false
*VT100.reverseVideo: false

*VT100.boldMode: false
*VT100.alwaysBoldMode: false
*VT100.allowBoldFonts: true

! Spell out the spacing and width: -medium-r-* alone also matches code7w, the double-width font.
*VT100.font:        -bwoolley-code7-medium-r-normal--7-70-75-75-m-60-iso10646-1
*VT100.boldFont:    -bwoolley-code7-bold-r-normal--7-70-75-75-m-60-iso10646-1
*VT100.utf8Fonts.font:        -bwoolley-code7-medium-r-normal--7-70-75-75-m-60-iso10646-1
*VT100.utf8Fonts.boldFont:    -bwoolley-code7-bold-r-normal--7-70-75-75-m-60-iso10646-1

! code7w: 12x7 glyphs for double-width characters (emoji)
*VT100.wideFont:              -bwoolley-code7-medium-r-normal--7-70-75-75-c-120-iso10646-1
*VT100.wideBoldFont:          -bwoolley-code7-medium-r-normal--7-70-75-75-c-120-iso10646-1
*VT100.utf8Fonts.wideFont:    -bwoolley-code7-medium-r-normal--7-70-75-75-c-120-iso10646-1
*VT100.utf8Fonts.wideBoldFont: -bwoolley-code7-medium-r-normal--7-70-75-75-c-120-iso10646-1

*VT100.internalBorder: 0

XTerm*termName: xterm-256color
UXTerm*termName: xterm-256color
