# syntax=docker/dockerfile:experimental

ARG font="code7"
FROM ubuntu:24.04 AS fontforge
ARG font="code7"
ENV font=${font}
RUN apt-get update \
	&& DEBIAN_FRONTEND=noninteractive apt-get install -yq --no-install-recommends \
		python3-fontforge \
		python3-fonttools \
		python3-pip \
	&& rm -rf /var/lib/apt/lists/*
RUN pip3 install --break-system-packages --no-cache-dir bdf2ttf

